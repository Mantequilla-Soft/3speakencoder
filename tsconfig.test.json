{
  // Type-checks the unit tests (vitest strips types without checking them).
  // The main tsconfig only covers src/ and excludes *.test.ts.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*", "tests/unit/**/*", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
