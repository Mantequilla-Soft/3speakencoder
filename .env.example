# 3Speak Encoder Configuration
# Copy this file to .env and fill in your actual values
# ⚠️  NEVER commit your .env file to version control!

# Hive Account Configuration (required)
HIVE_USERNAME=your-hive-username

# 🚨 CRITICAL: DID Identity Authentication Key (REQUIRED for persistent identity)
ENCODER_PRIVATE_KEY=generate-and-paste-your-key-here

# ⚠️  WITHOUT THIS KEY:
#     • Your encoder gets a new identity on every restart
#     • Dashboard tracking breaks (shows "new encoder" each time)
#     • Job attribution doesn't persist across sessions
# 
# 🔧 TO GENERATE A NEW KEY:
#     Run: node -e "console.log('ENCODER_PRIVATE_KEY=' + require('crypto').randomBytes(32).toString('base64'))"
#     Copy the output here and replace the placeholder above
# 
# ✅ This creates your DID identity for JWS signatures
# ✅ This is NOT your Hive private key
# ✅ This is only for encoder-gateway authentication  
# ✅ Keep this secret - never share publicly
# ✅ Same key = same encoder identity forever

# IPFS Configuration
# Local or remote IPFS API address (multiaddr format)
# Use localhost for local IPFS daemon: /ip4/127.0.0.1/tcp/5001
# Use remote IPFS node: /ip4/192.168.1.100/tcp/5001
IPFS_API_ADDR=/ip4/127.0.0.1/tcp/5001

# 3Speak IPFS Infrastructure (critical for uploads)


# Traffic Director for Hotnode Upload (automatic load balancing)
TRAFFIC_DIRECTOR_URL=https://cdn.3speak.tv/api/hotnode

# IPFS Cluster Support (optional - reduces main daemon load)
USE_CLUSTER_FOR_PINS=false


# Local Fallback Pinning (optional - for 3Speak-operated encoder nodes)
ENABLE_LOCAL_FALLBACK=false
LOCAL_FALLBACK_THRESHOLD=3
REMOVE_LOCAL_AFTER_SYNC=true

# Encoder Configuration
TEMP_DIR=./temp
FFMPEG_PATH=/usr/bin/ffmpeg
HARDWARE_ACCELERATION=true
MAX_CONCURRENT_JOBS=1

# Download Acceleration (optional — requires aria2 installed, see README)
# ARIA2_CONNECTIONS=12   # Parallel connections per download (tune for your latency: 4–16)

# Node Configuration
NODE_NAME=3speak-encoder-node

# Direct API Configuration (optional - for miniservice integration)
DIRECT_API_ENABLED=false
DIRECT_API_PORT=3002
# 🔐 Generate a secure random key if enabling direct API:
# DIRECT_API_KEY=generate-a-long-random-secure-key-here
# ⚠️  Keep this secret - it controls access to your encoder API!

# Dashboard (http://localhost:3001)
# By default it listens on all interfaces with no password: anyone on your
# network can view it and retry/release jobs. See "Dashboard security" in README.
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PASSWORD=
# DASHBOARD_PORT=3001
# Hostnames you open the dashboard by, besides IP addresses, localhost and this
# machine's name (requests for any other name are refused: DNS rebinding defense)
# DASHBOARD_ALLOWED_HOSTS=encoder.lan

# IPFS Storage Administration (LOCAL IPFS NODES)
# 🔐 Password protection for IPFS storage management features
# Requires ENABLE_LOCAL_FALLBACK=true (local IPFS daemon running)
# Available for both infrastructure and community nodes with local IPFS
STORAGE_ADMIN_PASSWORD=
# Set a strong password here - this enables:
# • IPFS pin listing and management
# • Migration of pins to supernode
# • Batch operations and garbage collection
# • Storage statistics and monitoring
# ⚠️  Only enable if you have local IPFS daemon and want to manage pins

# ============================================================================
# IPFS GATEWAY (Public Video Access)
# ============================================================================
# 🌐 Public IPFS gateway for downloading and verifying videos
# Used for:
# • Downloading source videos from IPFS when re-encoding
# • Verifying uploaded content accessibility
# • Manual CID verification links in logs
#
# IPFS_GATEWAY_URL=https://ipfs.3speak.tv

# ============================================================================
# EMBED SYSTEM (3Speak New Embed Platform)
# ============================================================================
# Where community encoders get their jobs. On by default (community mode):
# without a job source (this or DIRECT_API_ENABLED) the encoder never gets work.
#
# Two modes (mutually exclusive within the embed system):
#
#   managed   — Embed system pushes jobs to this encoder via POST /encode.
#               Requires DIRECT_API_ENABLED=true (the direct API IS the managed path).
#
#   community — This encoder polls the embed system for jobs via JWS-authenticated API.
#               Requires EMBED_GATEWAY_URL to be set.
#
# Both modes use the same encoding pipeline and webhook-based reporting.
#
EMBED_SYSTEM_ENABLED=true
EMBED_SYSTEM_MODE=community
EMBED_GATEWAY_URL=https://embed.3speak.tv
# Also report the running commit (encoder_commit, behind_by) in registration and
# heartbeats. Off until embed.3speak.tv stores it (Mantequilla-Soft/embedvideos#40).
# EMBED_REPORT_COMMIT=false

# ============================================================================
# GATED (PAID) CONTENT — 3speak-gate
# ============================================================================
# Only set these on encoders YOU operate.
#
# An encoder cannot transcode what it cannot read, so it necessarily holds the
# plaintext source of every video it touches. Key hygiene does not change that.
# On top of that, a node holding a gate API key can mint content keys for ANY
# video id. A community node must never be given one.
#
# Leaving these unset is safe: the node simply refuses gated jobs instead of
# encoding them in the clear. That refusal is deliberate. Plaintext published to
# public IPFS cannot be withdrawn, so failing the job is always the cheaper
# outcome.
#
# When set, gated jobs get AES-128 encrypted renditions plus an unencrypted
# preview, and the output is verified encrypted before it is uploaded.
#
# GATE_URL=https://gate.3speak.tv
# GATE_INTERNAL_API_KEY=

# ============================================================================
# VERSION CHECK
# ============================================================================
# The dashboard shows which commit this encoder runs and, every ~6 hours, asks
# the GitHub API (read-only, unauthenticated) how far it is behind the branch
# below. Nothing is downloaded or changed. Without network access the encoder
# behaves exactly as before.
#
# Opt-in: apply updates from the dashboard (git installs only, not Docker).
# Drains jobs first, rolls back on failure. See "Updating" in README.
# SELF_UPDATE_ENABLED=false
# UPDATE_PASSWORD=
#
# VERSION_CHECK_ENABLED=true
# VERSION_CHECK_REPO=Mantequilla-Soft/3speakencoder
# VERSION_CHECK_BRANCH=main
#
# Set automatically in Docker images (--build-arg GIT_COMMIT=...). Only set it
# by hand if the encoder runs from a copy without a .git directory.
# ENCODER_COMMIT=
