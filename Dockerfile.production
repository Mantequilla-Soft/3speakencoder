# 3Speak Video Encoder
# Official Docker image for easy deployment
#
#   docker build -f Dockerfile.production -t 3speak-encoder .

# ---- Build stage: all deps (tsc is a devDependency), compile, then drop devDeps
FROM node:22-alpine AS build

# sqlite3 falls back to compiling from source if no prebuilt binary matches
RUN apk add --no-cache python3 make g++

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

# ---- Runtime stage
FROM node:22-alpine

RUN apk add --no-cache ffmpeg aria2

WORKDIR /app
COPY --from=build --chown=node:node /app/package.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist

# data/: pending pins + local pin DB (persist it). work/: encode scratch space.
RUN mkdir -p /app/data /app/work && chown -R node:node /app

ENV NODE_ENV=production
ENV TEMP_DIR=/app/work

USER node

# Dashboard / Direct API
EXPOSE 3001 3002

# busybox wget ships with alpine; curl does not
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3001/api/health > /dev/null || exit 1

# Heap size is left to Node, which sizes it from the container's memory limit
CMD ["node", "--expose-gc", "dist/index.js"]

LABEL org.opencontainers.image.title="3Speak Video Encoder"
LABEL org.opencontainers.image.description="Decentralized video encoding for Web3"
LABEL org.opencontainers.image.url="https://3speak.tv"
LABEL org.opencontainers.image.source="https://github.com/Mantequilla-Soft/3speakencoder"
LABEL org.opencontainers.image.vendor="3Speak"
LABEL org.opencontainers.image.licenses="MIT"
